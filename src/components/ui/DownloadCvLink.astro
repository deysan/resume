---
import Icon from "./Icon.astro";
interface Props {
  variant?: "button" | "text";
}
const { variant = "text" } = Astro.props;
const href = `${import.meta.env.BASE_URL}Andrii_Deisan_CV.pdf`;
---

{variant === "button" ? (
  <a class="button button-blue" href={href} download>
    Download CV{" "}
    <span aria-hidden="true">
      <Icon name="arrow-down-linear" />
    </span>
  </a>
) : (
  <a class="download-text" href={href} download>
    Download CV <Icon name="arrow-down-linear" class="icon-inline" />
  </a>
)}
