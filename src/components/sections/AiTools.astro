---
import type { Resume } from "../../types/resume";
import TagList from "../ui/TagList.astro";
import Icon from "../ui/Icon.astro";

type Props = Pick<Resume, "tools">;
const resume = Astro.props;
---

<section class="card ai-tools" aria-labelledby="ai-title">
  <Icon name="stars-linear" class="spark" />
  <h2 id="ai-title">
    AI-assisted.
    <br />
    Human-reviewed.
  </h2>
  <p>
    I use AI-assisted workflows with engineering judgment, human review, and
    validation.
  </p>
  <TagList items={resume.tools} />
</section>
