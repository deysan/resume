---
import type { Resume } from "../../types/resume";
import ContactLinks from "../ContactLinks.astro";
import DownloadCvLink from "../ui/DownloadCvLink.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/andrii-deisan.jpg";

type Props = Pick<Resume, "name" | "focus" | "intro" | "email" | "socials">;
const resume = Astro.props;
---

<section class="hero" aria-labelledby="name">
  <div class="hero-grid">
    <div class="portrait-card">
      <Image
        src={portrait}
        alt="Andrii Deisan"
        width={800}
        height={800}
        widths={[480, 800, 1200]}
        sizes="(max-width: 450px) 420px, 400px"
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="card hero-copy">
      <p class="eyebrow">{resume.focus}</p>
      <p class="hero-role">
        Product
        <br />
        Engineer<span aria-hidden="true">.</span>
      </p>
      <p class="intro">{resume.intro}</p>
    </div>
    <div class="card hero-actions">
      <span class="hero-arrow" aria-hidden="true">
        ↘
      </span>
      <div>
        <p class="eyebrow">The full picture</p>
        <DownloadCvLink variant="button" />
        <a class="text-link" href="#experience">
          View experience <span aria-hidden="true">↙</span>
        </a>
      </div>
    </div>
  </div>
  <h1 id="name">{resume.name}</h1>
  <nav aria-label="Contact and social profiles">
    <ContactLinks email={resume.email} socials={resume.socials} />
  </nav>
</section>
