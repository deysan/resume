---
import Icon from "./ui/Icon.astro";
import type { Experience } from "../types/resume";
interface Props {
  job: Experience;
  index: number;
}
const { job, index } = Astro.props;
---

<article class="card job">
  <div class="job-top">
    <p class="company">{job.company}</p>
    <span class="job-number" aria-hidden="true">
      0{index + 1}
    </span>
  </div>
  <h3>{job.role}</h3>
  {job.focus && <p class="job-focus">{job.focus}</p>}
  <p class="date">{job.dates}</p>
  <ul class="job-bullets">
    {job.bullets.map((bullet) => (
      <li>{bullet}</li>
    ))}
  </ul>
  {job.workAccount && (
    <p class="work-account">
      During my time at Promova, I contributed through my work account:{" "}
      <a href={job.workAccount}>
        @adeisan <Icon name="arrow-right-up-linear" class="icon-inline" />
      </a>
    </p>
  )}
</article>
