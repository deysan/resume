---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/sections/Hero.astro";
import Profile from "../components/sections/Profile.astro";
import Impact from "../components/sections/Impact.astro";
import Experience from "../components/sections/Experience.astro";
import Skills from "../components/sections/Skills.astro";
import AiTools from "../components/sections/AiTools.astro";
import Education from "../components/sections/Education.astro";
import Languages from "../components/sections/Languages.astro";
import Projects from "../components/sections/Projects.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import resume from "../data/resume.json";
---

<Layout>
  <div class="page-shell">
    <SiteHeader location={resume.location} />
    <main id="main">
      <Hero
        name={resume.name}
        focus={resume.focus}
        intro={resume.intro}
        email={resume.email}
        socials={resume.socials}
      />
      <Profile summary={resume.summary} focusAreas={resume.focusAreas} />
      <Impact impact={resume.impact} />
      <div class="detail-grid">
        <Experience experience={resume.experience} />
        <div class="sidebar">
          <Skills skills={resume.skills} />
          <AiTools tools={resume.tools} />
          <Education
            education={resume.education}
            learning={resume.learning}
            moreLearning={resume.moreLearning}
          />
          <Languages languages={resume.languages} />
        </div>
      </div>
      <Projects />
      <ContactSection email={resume.email} socials={resume.socials} />
    </main>
    <SiteFooter name={resume.name} updated={resume.updated} />
  </div>
</Layout>
